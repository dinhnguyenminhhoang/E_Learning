Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "English Vocabulary A1",
  "description": "Basic English vocabulary for beginners",
  "target": "507f1f77bcf86cd799439011",
  "categoryId": "507f191e810c19729de860ea",
